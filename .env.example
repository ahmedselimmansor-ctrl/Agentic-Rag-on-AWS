# ---------------------------------------------------------------- app -----
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ----------------------------------------------------------- database -----
# docker compose overrides this to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_rag

# ----------------------------------------------- generation (OpenAI) ------
OPENAI_API_KEY=sk-...
# Verify this ID against the model list available to your account.
GENERATION_MODEL=gpt-5.6-luna
UTILITY_MODEL=gpt-5.6-luna
GENERATION_TEMPERATURE=0.3
GENERATION_MAX_OUTPUT_TOKENS=4096

# ----------------------- embedding + reranking (Alibaba Model Studio) -----
DASHSCOPE_API_KEY=sk-...
# Mainland China: https://dashscope.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
EMBEDDING_MODEL=tongyi-embedding-vision-flash
# MUST match what the model actually returns. Changing this requires a new
# migration and a full re-embed of every chunk.
EMBEDDING_DIM=1024
RERANK_MODEL=qwen3-rerank
RERANK_TOP_N=8

# ---------------------------------------------------------- retrieval -----
DENSE_TOP_K=30
SPARSE_TOP_K=30
RRF_K=60
MIN_RERANK_SCORE=0.15
HYBRID_ENABLED=true

# ----------------------------------------------------------- chunking -----
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ----------------------------------------------------- context window -----
MODEL_CONTEXT_WINDOW=200000
MAX_RETRIEVED_CONTEXT_TOKENS=12000
MAX_HISTORY_TOKENS=8000
MAX_LONG_TERM_MEMORIES=8

# --------------------------------------------------------------- agent ----
AGENT_MAX_STEPS=6

# ---------------------------------------------------------- web search ----
# tavily | serper | none
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_MAX_RESULTS=6

# -------------------------------------------------------------- uploads ---
# local | s3
UPLOAD_BACKEND=local
UPLOAD_DIR=/tmp/agentic-rag-uploads
S3_BUCKET=
S3_PREFIX=uploads/
AWS_REGION=us-east-1
MAX_UPLOAD_BYTES=26214400

# ----------------------------------------------------------------- auth ---
# jwt | header   (header trusts X-User-Email; local development only)
AUTH_MODE=jwt
# REQUIRED outside local dev, min 32 chars: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_REGISTRATION=true
PASSWORD_MIN_LENGTH=10

# ---------------------------------------------------------- rate limits ---
MAX_MESSAGES_PER_HOUR=120
MAX_UPLOADS_PER_HOUR=60

# ------------------------------------------------------------- ingestion ---
# inline | sqs   (sqs hands documents to the worker service)
INGESTION_MODE=inline
INGESTION_QUEUE_URL=
INGESTION_VISIBILITY_TIMEOUT=900

# ----------------------------------------------------------------- email ---
# ses | log | none   (log prints the message, link included, to the logs)
EMAIL_BACKEND=log
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Agentic RAG
APP_BASE_URL=http://localhost:8080
REQUIRE_EMAIL_VERIFICATION=false
VERIFICATION_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60
