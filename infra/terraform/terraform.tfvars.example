# Copy to terraform.tfvars and fill in. Never commit the filled version.

project     = "agentic-rag"
environment = "prod"
aws_region  = "us-east-1"

# ---- secrets -----------------------------------------------------------
openai_api_key    = "sk-..."
dashscope_api_key = "sk-..."
tavily_api_key    = ""    # leave empty to ship with web search disabled

# ---- models ------------------------------------------------------------
generation_model   = "gpt-5.6-luna"
embedding_model    = "tongyi-embedding-vision-flash"
embedding_dim      = 1024
rerank_model       = "qwen3-rerank"
dashscope_base_url = "https://dashscope-intl.aliyuncs.com"

# ---- sizing ------------------------------------------------------------
db_instance_class     = "db.t4g.medium"
db_multi_az           = false   # true for production HA
backend_desired_count = 2
backend_cpu           = 1024
backend_memory        = 2048

# ---- custom domain (optional) ------------------------------------------
# Certificate MUST live in us-east-1 for CloudFront.
# domain_name         = "rag.example.com"
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."

# ---- ingestion worker --------------------------------------------------
worker_desired_count = 1
worker_min_capacity  = 1    # 0 saves money; the first upload then cold-starts
worker_max_capacity  = 6

# ---- email -------------------------------------------------------------
# SES requires a verified identity in this region before it will send.
email_backend              = "log"   # switch to "ses" once verified
email_from                 = ""
require_email_verification = false

# ---- alerts ------------------------------------------------------------
# AWS emails a subscription confirmation you must click.
alert_email = ""
